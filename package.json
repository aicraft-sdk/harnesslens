{
  "name": "@ai-craft/harness-audit",
  "version": "0.0.1",
  "description": "Extensible AI-harness maturity scorer for auditing company repos",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "bin": {
    "harness-audit": "./cli.js"
  },
  "files": [
    "**/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck-spec": "tsc --noEmit -p tsconfig.spec.json"
  }
}
