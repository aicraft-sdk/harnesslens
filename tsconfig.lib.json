{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/tools/harness-audit-leaderboard",
    "declaration": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
