{
  "name": "harness-audit-leaderboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/harness-audit-leaderboard/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/tools/harness-audit-leaderboard",
        "main": "tools/harness-audit-leaderboard/src/cli.ts",
        "tsConfig": "tools/harness-audit-leaderboard/tsconfig.lib.json",
        "assets": ["tools/harness-audit-leaderboard/*.md"],
        "rootDir": "tools/harness-audit-leaderboard/src"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/harness-audit-leaderboard",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    }
  },
  "tags": []
}
