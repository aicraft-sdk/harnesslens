{
  "name": "harness-audit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/harness-audit/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/harness-audit",
        "main": "packages/harness-audit/src/index.ts",
        "tsConfig": "packages/harness-audit/tsconfig.lib.json",
        "assets": [
          "packages/harness-audit/*.md",
          "packages/harness-audit/NOTICE",
          { "input": "packages/harness-audit/THIRD_PARTY_LICENSES", "glob": "**/*", "output": "THIRD_PARTY_LICENSES" }
        ],
        "rootDir": "packages/harness-audit/src"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/harness-audit",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag",
        "fallbackCurrentVersionResolver": "disk"
      }
    }
  }
}
